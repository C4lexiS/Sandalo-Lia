        "jsCode": "return $input.all().map(item => {\n  const summary = item.json.summary || \"\";\n  const startDateTime = item.json.start?.dateTime;\n\n  // 1. Separar por guión con o sin espacios\n  let partes = summary.split(/\\s*-\\s*/).map(p => p.trim()).filter(p => p !== \"\");\n\n  // 2. Eliminar emojis (partes sin letras ni dígitos)\n  partes = partes.filter(p => /[a-zA-ZáéíóúÁÉÍÓÚñÑ0-9]/.test(p));\n\n  // 3. Helpers\n  const esTelefono = (p) => /^[\\d\\s\\+\\(\\)\\-]{6,}$/.test(p);\n  const esLocal = (p) => /^local\\d*$/i.test(p.trim());\n\n  // 4. Encontrar índice del teléfono\n  const indiceTel = partes.findIndex(p => esTelefono(p));\n\n  let partesFinales = [];\n\n  if (indiceTel !== -1) {\n    // Siempre tomar SOLO las 2 partes justo antes del teléfono (Nombre y Servicio)\n    const nombre = partes[indiceTel - 2];\n    const servicio = partes[indiceTel - 1];\n    const tel = partes[indiceTel];\n    const despuesDelTel = partes.slice(indiceTel + 1);\n\n    // ¿Hay Local justo después del teléfono?\n    const localParte = despuesDelTel.find(p => esLocal(p));\n\n    partesFinales = [nombre, servicio, tel].filter(Boolean);\n    if (localParte) partesFinales.push(localParte);\n\n  } else {\n    // Fallback: tomar primeras 3 partes\n    partesFinales = partes.slice(0, 3);\n  }\n\n  const finalSummary = partesFinales.join(' - ');\n\n  // 5. Procesamiento de fecha y hora\n  let fechaFormateada = \"\";\n  let horaFormateada = \"\";\n  if (startDateTime) {\n    const date = new Date(startDateTime);\n    const mm = String(date.getMonth() + 1).padStart(2, '0');\n    const dd = String(date.getDate()).padStart(2, '0');\n    const yyyy = date.getFullYear();\n    fechaFormateada = `${mm} ${dd} ${yyyy}`;\n    horaFormateada = date.toLocaleTimeString('en-US', {\n      hour: '2-digit',\n      minute: '2-digit',\n      hour12: true\n    });\n  }\n\n  return {\n    json: {\n      ...item.json,\n      summary_limpio: finalSummary,\n      guiones_detectados: (summary.match(/-/g) || []).length,\n      fecha_cita: fechaFormateada,\n      hora_cita: horaFormateada\n    }\n  };\n});"
      },
